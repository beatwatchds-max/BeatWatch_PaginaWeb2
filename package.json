    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.34.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
